#!/bin/sh
# Lo que git manda al pre-push (qué rama va a dónde), para el control del entorno.
refs=$(cat)
# Antes de subir: sintaxis de todo el JavaScript (un error en functions/ tumba el despliegue entero).
python tools/check_js.py || { echo "pre-push: hay errores de sintaxis; no se sube."; exit 1; }
# Los JS y el CSS del admin, el panel y «Tu cuenta» se guardan un año: su `?v=` tiene que ser la huella de lo que se sube (lo pone el pre-commit).
python tools/versiones.py --check HEAD || { echo "pre-push: hay versiones viejas (admin, panel o «Tu cuenta»); no se sube."; exit 1; }
# El único indicador de carga es la aguja de Klendar (y los esqueletos).
python tools/indicadores_check.py || { echo "pre-push: hay un indicador de carga que no es la aguja de Klendar."; exit 1; }
python tools/esqueletos_check.py || { echo "pre-push: hay una pantalla sin su esqueleto (§4zzz-cargas, P3)."; exit 1; }
python tools/i18n_missing.py panel >/dev/null && python tools/i18n_missing.py admin >/dev/null || { echo "pre-push: faltan traducciones."; exit 1; }
# «Tu cuenta» y el panel en catalán, gallego, euskera, francés, alemán e italiano: lo que falta en cada diccionario.
python tools/i18n_missing.py --lang all >/dev/null || { echo "pre-push: faltan textos en los idiomas nuevos (python tools/i18n_missing.py --lang all --todo)."; exit 1; }
# Las pruebas de tools/ no nombran un Supabase a mano y cargan Playwright con la red de seguridad (tools/_supabase_simulado.mjs).
python tools/supabase_refs_check.py || { echo "pre-push: una prueba de tools/ apunta a mano a un Supabase; no se sube."; exit 1; }
# La ayuda de la app no habla de precios ni lleva a pagar (Apple 3.1.1 y 3.1.3; Play, Pagos §4), y toda pregunta tiene una categoría válida de su pestaña (§4zzz-faq).
python tools/ayuda_app_check.py || { echo "pre-push: la ayuda de la app habla de precios, no está al día o hay una pregunta sin categoría; no se sube."; exit 1; }
# «Tu cuenta» está en /cuenta/: que no reaparezca /app/ ni un `#/` en ella.
python tools/sin_app_check.py || { echo "pre-push: sigue la dirección vieja de «Tu cuenta»; no se sube."; exit 1; }
# Los enlaces a «Tu cuenta», al panel y al admin llevan a una pantalla que existe (sin `//` ni rutas inventadas; revisión 9-11, I6).
python tools/rutas_check.py || { echo "pre-push: hay un enlace a una pantalla que no existe; no se sube."; exit 1; }
# robots.txt es lo que genera build_site.py (robots(), su única fuente) y nombra todos los sitemaps.
python tools/robots_check.py || { echo "pre-push: robots.txt no es lo que genera build_site.py; no se sube."; exit 1; }
# Pruebas rápidas con datos de mentira (tools/_web_con_datos.mjs; unos 8 s): distancias sin ubicación de verdad, municipios, las barras de distancia y precio,
# «Seguir» sin esperar a la base, los mensajes de error de entrar, la caché del borde (qué se guarda y qué nunca) y los buscadores (sitemaps sin noindex, JSON-LD, umbrales). La de «Seguir» abre Chromium: Playwright, el de PW= o
# el de la caché de npx; sin ninguno, se avisa y se salta.
for c in tools/revseg_check.mjs tools/revnegocio_check.mjs tools/ssr_espera_check.mjs tools/doble_envio_check.mjs tools/rutas_raras_check.mjs tools/alergenos_check.mjs tools/distancias_check.mjs tools/espana_check.mjs tools/auth_errores_check.cjs tools/precio_local_check.mjs tools/barras_check.mjs tools/compartir_check.mjs tools/ficha_una_vez_check.mjs tools/codigos_check.mjs tools/publicar_check.mjs tools/publicar2_check.mjs tools/reservas2_check.mjs tools/contacto_check.mjs tools/guias_check.mjs tools/encargos_check.mjs tools/aperturas_check.mjs tools/preguntas_reservar_check.mjs tools/amano_check.mjs tools/captcha_check.mjs tools/ayuda_guiada_check.mjs tools/cache_borde_check.mjs tools/celda_check.mjs tools/chips_check.mjs tools/seo_check.mjs tools/sitemap_agenda_check.mjs; do
  node "$c" >/dev/null 2>&1 || { echo "pre-push: falla $c (node $c para ver qué); no se sube."; exit 1; }
done
# El CPU de cada ruta (§4zzz-cpu-web; el plan gratis de Cloudflare corta a los 10 ms): middleware y página con la base simulada, en frío y en caliente,
# sin red (unos 12 s). Falla si una ruta pasa de 8 ms en caliente o de 40 en frío (node tools/cpu_check.mjs para ver la tabla).
node tools/cpu_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/cpu_check.mjs (CPU de las Functions; node tools/cpu_check.mjs para ver qué); no se sube."; exit 1; }
# El admin en admin.klendar.app (§4zzz-admindom): qué hace cada host, la 404 de las direcciones viejas y las cabeceras del admin (sin navegador, 1 s).
node tools/admin_dominio_check.mjs --sin-navegador >/dev/null 2>&1 || { echo "pre-push: falla tools/admin_dominio_check.mjs --sin-navegador (el admin en su subdominio); no se sube."; exit 1; }
# El panel con direcciones limpias (§4zzz-panellimpio): qué sirve el servidor en cada ruta, la barra final, las cabeceras, _routes.json y ningún `#/` (sin navegador, 1 s).
node tools/panel_rutas_check.mjs --sin-navegador >/dev/null 2>&1 || { echo "pre-push: falla tools/panel_rutas_check.mjs --sin-navegador (las direcciones del panel); no se sube."; exit 1; }
[ -n "${PW:-}" ] || PW=$(ls -d "$HOME"/AppData/Local/npm-cache/_npx/*/node_modules/playwright 2>/dev/null | head -1)
if [ -n "$PW" ]; then
  PW="$PW" node tools/seguir_optimista_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/seguir_optimista_check.mjs; no se sube."; exit 1; }
  # El scroll sin fin de Descubre vuelve a intentarlo si la página siguiente no llega (§4zzz-revweb; unos 17 s).
  PW="$PW" node tools/feed_reintenta_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/feed_reintenta_check.mjs; no se sube."; exit 1; }
  # «Tu cuenta» (§4zzz-revweb): #view sin región viva y el título anunciado, una consulta de zonas, «Algo ha fallado» reintentado al volver la red (unos 5 s).
  PW="$PW" node tools/cuenta_revweb_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/cuenta_revweb_check.mjs; no se sube."; exit 1; }
  # La web pública (§4zzz-revweb): «Busca tu municipio» con Intro deprisa… (unos 5 s).
  PW="$PW" node tools/revweb_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/revweb_check.mjs; no se sube."; exit 1; }
  # «Ya la canjeaste» en las tarjetas (§4zzz-canjeada de la app): con sesión, «Ver tu código» / «Ver tu entrada», lo gastado fuera de Descubre y en gris en lo demás; sin sesión, nada y la página del borde sin nada personal (unos 15 s).
  PW="$PW" node tools/ya_canjeada_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/ya_canjeada_check.mjs (node tools/ya_canjeada_check.mjs para ver qué); no se sube."; exit 1; }
  # Turnstile junto a su formulario y quitado al dejarlo; el admin, tras entrar, al Resumen (Iván, 18-11).
  PW="$PW" node tools/captcha_sitio_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/captcha_sitio_check.mjs; no se sube."; exit 1; }
  # «Cerca de mí» sola con el permiso ya dado (§4zzz-ubicacion-web): Explorar y Descubre a su celda una vez, lo elegido sin pisar, sin permiso nada; y el mapa en su zona sin resultados (el mapa, solo en Chromium; unos 2 min).
  PW="$PW" UBIC_RAPIDO=1 node tools/ubicacion_sola_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/ubicacion_sola_check.mjs (node tools/ubicacion_sola_check.mjs para ver qué); no se sube."; exit 1; }
  # La ubicación como la app, 2.ª parte (§4zzz-ubicacion-web2): Partidos, Grupos, Sorteos y guías con la celda (y lat/lng de antes con 301), solas con el permiso ya dado;
  # el sello por visita y «Estaba cerrado» sin pedirla al cargar; «Avísame si…» con tu ciudad (solo Chromium; unos 90 s).
  PW="$PW" UBIC2_RAPIDO=1 node tools/ubicacion_web2_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/ubicacion_web2_check.mjs (node tools/ubicacion_web2_check.mjs para ver qué); no se sube."; exit 1; }
  # La franja «Mira lo que hay cerca de ti · Activar» (§4zzz-ubicacion-web2): solo con el permiso por preguntar, topes de la app, sin saltos (solo Chromium).
  PW="$PW" AVISO_RAPIDO=1 node tools/aviso_ubicacion_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/aviso_ubicacion_check.mjs (node tools/aviso_ubicacion_check.mjs para ver qué); no se sube."; exit 1; }
  # «Imprimir cartel» y la pegatina de escaparate (§4zzz-cartel): el QR a la publicación o a la ficha, los 8 idiomas, una página al imprimir (unos 15 s).
  PW="$PW" node tools/cartel_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/cartel_check.mjs (node tools/cartel_check.mjs para ver qué); no se sube."; exit 1; }
  # El admin en su subdominio en Chromium y WebKit: la 404 de lo viejo, la sesión vieja borrada en klendar.app, entrar con el segundo factor, «Confirma que eres tú» y la sesión solo allí (unos 30 s).
  PW="$PW" node tools/admin_dominio_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/admin_dominio_check.mjs (node tools/admin_dominio_check.mjs para ver qué); no se sube."; exit 1; }
  # Las direcciones del panel en Chromium y WebKit: cada sección en su ruta sin `#` ni recargar, atrás y adelante, recargar, la barra final y `#/x` a /panel (unos 30 s).
  PW="$PW" node tools/panel_rutas_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/panel_rutas_check.mjs (node tools/panel_rutas_check.mjs para ver qué); no se sube."; exit 1; }
  # El panel con las cuatro secciones de la app (§4zzz-panelapp): menú o barra según el tamaño, papeles, entidad, direcciones viejas (unos 25 s).
  PW="$PW" node tools/panel_app_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/panel_app_check.mjs (node tools/panel_app_check.mjs para ver qué); no se sube."; exit 1; }
  # Tamaños coherentes (§4zzz-coherencia1-3): el panel, la web pública y «Tu cuenta» y el admin; los bloques comparten los bordes, nada se sale de su tarjeta, los filtros de borde a borde y los campos con la misma letra, de 360 a 1.920, en Chromium y WebKit (unos 4 min).
  PW="$PW" node tools/coherencia_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/coherencia_check.mjs (node tools/coherencia_check.mjs para ver qué); no se sube."; exit 1; }
  # Nada pegado ni pisado, como la app (§4zzz-solapes-web): bloques hermanos a 4 px como poco, ningún texto fuera de su tarjeta y sin desplazamiento de lado;
  # una muestra de la web pública, «Tu cuenta», el panel (dueña, camarero y entidad) y el admin a 360 y 1280, y con la letra al 200 % (390) y al 130 % (1280) (1–2 min;
  # la completa, a mano: node tools/solapes_check.mjs).
  PW="$PW" SOLAPES_RAPIDO=1 node tools/solapes_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/solapes_check.mjs (SOLAPES_RAPIDO=1 node tools/solapes_check.mjs para ver qué); no se sube."; exit 1; }
  # Tablet y pantallas anchas (§4zzz-tablet): lo público, «Tu cuenta», el panel y el admin a 768x1024, 1024x768, 1366x1024 y 1920x1080 (unos 2 min).
  PW="$PW" TABLET_RAPIDO=1 node tools/tablet_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/tablet_check.mjs (node tools/tablet_check.mjs para ver qué); no se sube."; exit 1; }
  # La CSP de scripts (§4zzz-csp): ni <script> en línea ni on…=, y las páginas principales sin violaciones en Chromium y WebKit, móvil y escritorio (unos 4 min).
  PW="$PW" CSP_CALLADO=1 node tools/csp_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/csp_check.mjs (CSP; node tools/csp_check.mjs para ver qué); no se sube."; exit 1; }
  # Accesibilidad (axe-core, foco con el teclado, reflujo a 320 px; unos 95 s): con axe-core instalado (npm install -g axe-core).
  if [ -n "${AXE:-}" ] || [ -f "${APPDATA:-}/npm/node_modules/axe-core/axe.min.js" ]; then
    PW="$PW" node tools/a11y_check.mjs >/dev/null 2>&1 || { echo "pre-push: falla tools/a11y_check.mjs (accesibilidad; node tools/a11y_check.mjs para ver qué); no se sube."; exit 1; }
  else
    echo "pre-push: sin axe-core (npm install -g axe-core), me salto tools/a11y_check.mjs."
  fi
else
  echo "pre-push: sin Playwright, me salto tools/seguir_optimista_check.mjs y tools/captcha_sitio_check.mjs (y la CSP solo sin navegador)."
  node tools/csp_check.mjs --sin-navegador >/dev/null 2>&1 || { echo "pre-push: falla tools/csp_check.mjs --sin-navegador (CSP); no se sube."; exit 1; }
fi
# Dev ↔ prod solo a propósito (KLENDAR_CAMBIO_ENTORNO=1), config.js y page.js al mismo Supabase y Turnstile con sus textos.
printf '%s\n' "$refs" | python tools/entorno_check.py || { echo "pre-push: el cambio de entorno no cuadra (ver arriba); no se sube."; exit 1; }
echo "pre-push: todo bien."
