/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/panel/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  ! Permissions-Policy
  Permissions-Policy: geolocation=(self), camera=(self), microphone=()

# «Mi Klendar»: la ubicación solo para «Avísame si…» (zona fija), y siempre
# a petición de la persona.
/app/*
  X-Robots-Tag: noindex, nofollow
  ! Permissions-Policy
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/widget/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  X-Robots-Tag: noindex

# Explorar: «Cerca de mí» pide la ubicación (solo al pulsarlo).
/explorar/*
  ! Permissions-Policy
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
/en/explore/*
  ! Permissions-Policy
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

# Clave de IndexNow: los buscadores comprueban que este archivo contiene la
# clave con la que la base les avisa de páginas nuevas (pública por diseño).
/fb10641a46f1f09afa85f2dd2958ea4b.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

# Universal Links de iOS (y autorrelleno de contraseñas): Apple lo pide como
# JSON aunque el archivo no tenga extensión. Sin redirecciones ni caché larga:
# el CDN de Apple lo vuelve a leer al instalar/actualizar la app. Cambiar
# TEAMID por el Team ID de Apple Developer (docs/RUNBOOK.md de la app →
# «iOS con Codemagic»); con el marcador no hace nada.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

# Estáticos versionados: cada página los pide con `?v=` y ese número se sube
# cada vez que cambian, así que el navegador los puede guardar un año sin
# volver a preguntar. OJO: al tocar uno de estos ficheros, subir su `?v=` en
# todos los sitios que lo enlazan (si no, quien ya lo tenga no lo verá).
# Las fuentes no cambian nunca: si algún día cambian, con otro nombre.
# (Los iconos y las imágenes sin `?v=` se quedan con la caché de siempre.)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/screens/*
  Cache-Control: public, max-age=31536000, immutable
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
